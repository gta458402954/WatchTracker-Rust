{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchtracker.local/schemas/task-contract.schema.json",
  "title": "WatchTracker AI Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "task_id", "owner", "repository", "governance", "workspace_policy", "commit_policy", "change_budget", "steps", "evidence", "locking", "forbidden_phrases", "waivers"],
  "properties": {
    "schema_version": { "const": 2 },
    "contract_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Z]+-[0-9]{3}([a-z])?$" },
    "owner": { "const": "CODEX" },
    "supersedes": { "type": ["string", "null"] },
    "previous_contract_bytes_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
    "authorization_reason": { "type": "string" },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "expected_root_name", "expected_worktree", "expected_common_git_dir", "expected_remote", "expected_branch", "expected_base", "allow_detached_head"],
      "properties": {
        "repository_id": { "type": "string", "format": "uuid" }, "expected_root_name": { "type": "string" },
        "expected_worktree": { "type": "string" }, "expected_common_git_dir": { "type": "string" }, "expected_remote": { "type": "string" },
        "expected_branch": { "type": "string" }, "expected_base": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "allow_detached_head": { "type": "boolean" }
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "expected_commit", "require_clean", "bootstrap", "tool_sha256"],
      "properties": {
        "root": { "type": "string" }, "expected_commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
        "require_clean": { "type": "boolean" }, "bootstrap": { "type": "boolean" },
        "tool_sha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } }
      }
    },
    "workspace_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_modified_files", "allowed_generated_paths", "forbidden_modified_files", "monitored_roots", "conditional_files"],
      "properties": {
        "allowed_modified_files": { "$ref": "#/$defs/stringArray" }, "allowed_generated_paths": { "$ref": "#/$defs/stringArray" },
        "forbidden_modified_files": { "$ref": "#/$defs/stringArray" }, "monitored_roots": { "$ref": "#/$defs/stringArray" },
        "conditional_files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "activation", "approved_by"], "properties": { "path": { "type": "string" }, "activation": { "const": "STOP_AND_REISSUE_CONTRACT" }, "approved_by": { "const": "CODEX" } } } }
      }
    },
    "commit_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_staged_files", "required_staged_files", "forbidden_staged_files", "protected_files", "protected_regions", "executor_summary_files"],
      "properties": {
        "allowed_staged_files": { "$ref": "#/$defs/stringArray" }, "required_staged_files": { "$ref": "#/$defs/stringArray" }, "forbidden_staged_files": { "$ref": "#/$defs/stringArray" },
        "protected_files": { "$ref": "#/$defs/stringArray" }, "executor_summary_files": { "$ref": "#/$defs/stringArray" },
        "protected_regions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "begin_marker", "end_marker"], "properties": { "path": { "type": "string" }, "begin_marker": { "type": "string" }, "end_marker": { "type": "string" } } } }
      }
    },
    "change_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_files", "max_insertions", "max_deletions", "max_binary_changes", "forbid_file_rewrite", "preserve_encoding", "preserve_line_endings"],
      "properties": { "max_files": { "type": "integer", "minimum": 0 }, "max_insertions": { "type": "integer", "minimum": 0 }, "max_deletions": { "type": "integer", "minimum": 0 }, "max_binary_changes": { "type": "integer", "minimum": 0 }, "forbid_file_rewrite": { "type": "boolean" }, "preserve_encoding": { "type": "boolean" }, "preserve_line_endings": { "type": "boolean" } }
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "environment_allowlist", "sensitive_names", "forbid_sensitive_command_line", "capture_policy", "redaction_rules_version"],
      "properties": { "root": { "type": "string" }, "environment_allowlist": { "$ref": "#/$defs/stringArray" }, "sensitive_names": { "$ref": "#/$defs/stringArray" }, "forbid_sensitive_command_line": { "type": "boolean" }, "capture_policy": { "const": "REDACT_AT_INGRESS" }, "redaction_rules_version": { "type": "integer", "minimum": 1 } }
    },
    "locking": { "type": "object", "additionalProperties": false, "required": ["scope", "stale_lock_requires_recovery"], "properties": { "scope": { "const": "WORKTREE" }, "stale_lock_requires_recovery": { "const": true } } },
    "forbidden_phrases": { "$ref": "#/$defs/stringArray" },
    "waivers": { "type": "array", "items": { "$ref": "#/$defs/waiver" } }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "step": { "type": "object", "additionalProperties": false, "required": ["id", "executable", "arguments", "cwd", "timeout_seconds", "on_nonzero", "requires", "observation_seconds"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "executable": { "type": "string" }, "arguments": { "$ref": "#/$defs/stringArray" }, "cwd": { "type": "string" }, "timeout_seconds": { "type": "integer", "minimum": 1 }, "on_nonzero": { "enum": ["STOP", "CONTINUE_DIAGNOSTICS"] }, "requires": { "$ref": "#/$defs/stringArray" }, "observation_seconds": { "type": "integer", "minimum": 0 }, "health_stdout_regex": { "type": ["string", "null"] }, "waiver_id": { "type": ["string", "null"] }, "process_path_patterns": { "$ref": "#/$defs/stringArray" } } },
    "waiver": { "type": "object", "additionalProperties": false, "required": ["waiver_id", "command_step", "expected_exit_codes", "gate_effect", "continue_for_diagnostics", "baseline_commit", "baseline_evidence_sha256", "allowed_paths", "diagnostic_fingerprints", "new_diagnostics_forbidden", "modified_paths_must_be_clean", "expires_after_task"], "properties": { "waiver_id": { "type": "string" }, "command_step": { "type": "string" }, "expected_exit_codes": { "type": "array", "items": { "type": "integer" } }, "gate_effect": { "const": "FAIL" }, "continue_for_diagnostics": { "type": "boolean" }, "baseline_commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }, "baseline_evidence_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "allowed_paths": { "$ref": "#/$defs/stringArray" }, "diagnostic_fingerprints": { "$ref": "#/$defs/stringArray" }, "new_diagnostics_forbidden": { "const": true }, "modified_paths_must_be_clean": { "const": true }, "expires_after_task": { "type": "string" } } }
  }
}
